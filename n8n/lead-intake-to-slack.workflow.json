        "text": "={{ 'Nuevo lead en LeadFlow\\nEmpresa: ' + $('Create lead in LeadFlow API').first().json.data.companyName + '\\nContacto: ' + $('Create lead in LeadFlow API').first().json.data.contactName + '\\nServicio solicitado: ' + $('Create lead in LeadFlow API').first().json.data.serviceRequested + '\\nAsesor asignado (ID): ' + $('Create lead in LeadFlow API').first().json.data.assignedAdvisorId + '\\nEmail: ' + $('Create lead in LeadFlow API').first().json.data.email + '\\nDetalles: ' + ($('Create lead in LeadFlow API').first().json.data.details || 'Sin detalles') }}",
