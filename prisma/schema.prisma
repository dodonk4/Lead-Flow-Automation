generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Lead {
  id                String         @id @default(uuid()) @db.Uuid
  companyName       String         @map("company_name") @db.VarChar(160)
  contactName       String         @map("contact_name") @db.VarChar(160)
  email             String         @db.VarChar(320)
  serviceRequested  String         @map("service_requested") @db.VarChar(100)
  details           String?        @db.Text
  assignedAdvisorId String?        @map("assigned_advisor_id") @db.Uuid
  assignedAdvisor   Advisor?       @relation("AssignedLeads", fields: [assignedAdvisorId], references: [id], onDelete: SetNull)
  notifications     Notification[]
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  @@index([assignedAdvisorId])
  @@index([createdAt])
  @@map("leads")
}

model Advisor {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @db.VarChar(160)
  email           String           @unique @db.VarChar(320)
  isActive        Boolean          @default(true) @map("is_active")
  assignedLeads   Lead[]           @relation("AssignedLeads")
  assignmentRules AssignmentRule[]
  notifications   Notification[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@map("advisors")
}

model AssignmentRule {
  id        String   @id @default(uuid()) @db.Uuid
  service   String   @unique @db.VarChar(100)
  advisorId String   @map("advisor_id") @db.Uuid
  advisor   Advisor  @relation(fields: [advisorId], references: [id], onDelete: Restrict)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([advisorId])
  @@map("assignment_rules")
}

model Notification {
  id         String             @id @default(uuid()) @db.Uuid
  leadId     String             @map("lead_id") @db.Uuid
  lead       Lead               @relation(fields: [leadId], references: [id], onDelete: Restrict)
  advisorId  String             @map("advisor_id") @db.Uuid
  advisor    Advisor            @relation(fields: [advisorId], references: [id], onDelete: Restrict)
  channel    String             @default("slack") @db.VarChar(32)
  status     NotificationStatus @default(PENDING)
  message    String             @db.Text
  externalId String?            @map("external_id") @db.VarChar(255)
  sentAt     DateTime?          @map("sent_at")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  @@index([leadId])
  @@index([advisorId])
  @@index([status])
  @@map("notifications")
}
